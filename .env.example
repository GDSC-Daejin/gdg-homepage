# Supabase 프로젝트 URL (Supabase 대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon(public) API key (Supabase 대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 배포된 사이트의 절대 URL (출석 QR 코드 생성에 사용, 예: https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=

# 슬랙 인커밍 웹훅 URL (출석 경고 알림 전송용, api.slack.com/messaging/webhooks에서 발급)
SLACK_WEBHOOK_URL=

# 노션 internal integration의 API 키 (notion.so/my-integrations에서 발급, 자료실 연동용)
NOTION_API_KEY=

# 자료실로 사용할 노션 데이터베이스 ID
NOTION_DATABASE_ID=

# Vercel Cron 요청 인증용 시크릿 (임의의 랜덤 문자열, /api/cron/* 라우트에서 검증)
CRON_SECRET=

# Supabase 서비스 롤 키 (Project Settings > API, 크론 등 서버 전용 작업에서만 사용 — 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=
