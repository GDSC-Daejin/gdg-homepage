# Supabase 프로젝트 URL (Supabase 대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon(public) API key (Supabase 대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 배포된 사이트의 절대 URL (출석 QR 코드 생성에 사용, 예: https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=

# 슬랙 인커밍 웹훅 URL (공지 발행·이벤트 리마인드 등 공개 알림용, api.slack.com/messaging/webhooks에서 발급)
SLACK_WEBHOOK_URL=

# 운영진 알림(출석 경고·문의 등록)을 보낼 봇의 xoxb- 토큰 — Jarvis 앱의 Bot User OAuth Token
# SLACK_BOT_TOKEN(꼬북봇)과 별개다. 미설정 시 발송하지 않는다(꼬북봇으로 대신 나가지 않게 함)
SLACK_JARVIS_BOT_TOKEN=

# 출석 경고 명단·새 문의 알림을 받을 운영진 프라이빗 채널 ID (예: C0123ABCDEF — 채널 이름이 아니라 ID)
# 슬랙에서 채널 열고 상단 채널명 클릭 > 팝업 맨 아래 "채널 ID" 복사. Jarvis를 그 채널에 초대해야 발송된다.
SLACK_ADMIN_CHANNEL_ID=

# 정기세션 확정 알림을 보낼 공지사항 채널 ID. Jarvis를 이 채널에 초대해야 한다.
SLACK_NOTICE_CHANNEL_ID=

# 노션 internal integration의 API 키 (notion.so/my-integrations에서 발급, 자료실 연동용)
NOTION_API_KEY=

# 자료실로 사용할 노션 데이터베이스 ID
NOTION_DATABASE_ID=

NOTION_MEETINGS_DATABASE_ID=

# 회의 시간을 확정하면 "n월 n일 위클리" 페이지를 만들 노션 DB ID (모여봐요 지디엣나무 숲)
NOTION_WEEKLY_DATABASE_ID=
# 위 페이지의 "진행 기수" 값. 비워두면 기수를 넣지 않는다 (기수 필터 뷰에서 안 보임)
NOTION_WEEKLY_SEASON=

# Vercel Cron 요청 인증용 시크릿 (임의의 랜덤 문자열, /api/cron/* 라우트에서 검증)
CRON_SECRET=

# Supabase 서비스 롤 키 (Project Settings > API, 크론 등 서버 전용 작업에서만 사용 — 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# Resend API 키 (합불 통보 이메일 발송용, resend.com에서 발급 — 미설정 시 발송 생략)
RESEND_API_KEY=

# 합불 이메일 발신 주소 (도메인 인증 필요, 예: GDG DJU <noreply@yourdomain.com>)
RESEND_FROM=

# 네이버 클라우드 플랫폼 Maps — Geocoding(서버 전용). Client ID / Client Secret
# 엔드포인트는 https://maps.apigw.ntruss.com/map-geocode/v2/geocode
# (구 naveropenapi.apigw.ntruss.com은 키가 맞아도 401 "Permission Denied" 반환)
NCP_MAP_API_KEY_ID=
NCP_MAP_API_KEY=

# 네이버 Dynamic Map 프론트 스크립트용 Client ID (NCP_MAP_API_KEY_ID와 같은 값, 브라우저 노출 — 도메인 제한으로 보호)
NEXT_PUBLIC_NCP_MAP_KEY_ID=

# Google Meet 링크 자동생성 (서버 전용 — 별도 GCP 프로젝트, meetings.space.created 스코프)
# refresh token은 scripts/get-google-meet-token.mjs로 1회 획득
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=

# GA4 계측(클라이언트) — 데이터 스트림의 측정 ID (G-XXXX). 미설정 시 계측 비활성화
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# GA4 Data API(서버 전용) — admin 분석 대시보드 조회용. 세 값 모두 없으면 대시보드는 폴백 표시
# GA4_PROPERTY_ID: GA 관리 > 속성 설정의 숫자 속성 ID (스트림 ID 아님)
# GA_SA_*: GCP 서비스 계정 JSON의 client_email / private_key (서비스 계정을 GA4 속성 뷰어로 추가 필요)
GA4_PROPERTY_ID=
GA_SA_CLIENT_EMAIL=
GA_SA_PRIVATE_KEY=

# Vercel 배포 상태 위젯(admin 분석 페이지) — 미설정 시 위젯 숨김
# 이름에 VERCEL_ 프리픽스 금지(예약됨) → VC_ 사용
# VC_TOKEN: vercel.com/account/tokens 에서 발급 (읽기 전용)
# VC_PROJECT_ID: 프로젝트 Settings > General. VC_TEAM_ID는 팀 프로젝트만
VC_TOKEN=
VC_PROJECT_ID=
VC_TEAM_ID=
